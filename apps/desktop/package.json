{
  "name": "@hybrid/coach-desktop",
  "version": "1.0.7",
  "private": true,
  "description": "THE Hybrid Coach \u2014 Capgo UI updates and GitHub desktop updates",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "typecheck": "node --check src/main.cjs && node --check src/updater.cjs && node --check desktop.smoke.mjs && node --check src/live-updater.cjs && node --check src/preload.cjs",
    "dist": "electron-builder --config electron-builder.cjs --win nsis --publish never",
    "check": "node desktop.smoke.mjs && node --test src/live-updater.test.cjs"
  },
  "dependencies": {
    "@capgo/electron-updater": "0.0.6",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hybrid.coach",
    "productName": "THE Hybrid Coach",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.cjs",
      "package.json",
      "node_modules/electron-updater/**/*",
      "!**/*.map"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/reflectprotect123-max/the-adaptivebrain-/releases/download/coach-desktop-latest"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "THE-Hybrid-Coach-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "en-GB",
      "en-US"
    ]
  }
}
